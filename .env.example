# Chave que o Bubble envia no header X-API-Key (gere uma longa e aleatória)
API_KEY=troque-por-uma-chave-secreta

# --- Bubble ---
# Domínio do app e ambiente: "test" usa /version-test, "live" usa produção
BUBBLE_APP_URL=https://seu-app.bubbleapps.io
BUBBLE_ENV=test
# Opcional: se definido, sobrescreve APP_URL + ENV
# BUBBLE_BASE_URL=https://seu-app.bubbleapps.io/version-test/api/1.1/obj
BUBBLE_API_TOKEN=coloque-o-token-aqui
BUBBLE_DATA_TYPE=conciliacao
# Data type que recebe o status da importação (modo assíncrono)
BUBBLE_IMPORTACAO_TYPE=importacao
BUBBLE_BATCH_SIZE=1000
BUBBLE_MAX_RETRIES=5
BUBBLE_TIMEOUT=300

# --- Tratamento ---
# Campo do Bubble que recebe o importacao_id (vazio = não envia)
CAMPO_IMPORTACAO=importacao
# Campos que definem uma linha duplicada
CHAVE_DUPLICIDADE=cpf,data,tipo_cobranca,valor
# true = descarta CPFs com dígito verificador inválido
VALIDAR_DIGITO_CPF=false

# --- Download ---
# Hosts permitidos para file_url (sufixo do domínio, separados por vírgula)
ALLOWED_FILE_HOSTS=amazonaws.com,cdn.bubble.io
MAX_FILE_MB=25

LOG_LEVEL=INFO

# Documentação interativa em /docs (deixe false em produção)
EXPOR_DOCS=false
